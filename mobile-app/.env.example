# ==============================================================================
# REMEMBERED - BACKEND & ENVIRONMENT CONFIGURATION
# ==============================================================================
# NOTE: These variables belong on your secure server/cloud backend (e.g. Cloud Run).
# DO NOT embed private secrets into the client-side iOS binary or Info.plist!

# Port on which the Node/Express BFF gateway listens
PORT=3000

# Node runtime environment
NODE_ENV=production

# Google Gemini AI API Key (Used strictly server-side in server.ts for biography generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: JWT Secret for Custodian Authentication & Session Signing
JWT_SECRET=your_secure_random_jwt_secret_here

# ==============================================================================
# IOS CLIENT CONFIGURATION (Configured via Xcode Build Settings or xcconfig)
# ==============================================================================
# Development API Gateway:
# API_BASE_URL=https://dev-api.remembered.io

# Production API Gateway:
# API_BASE_URL=https://api.remembered.io
